CREATE OR REPLACE TABLE FUNCTION `pulse-dev-477810.KPIs.fn_cy_resigned_metrics` (
    p_month STRING,
    p_gender_type STRING,
    p_function_name STRING,
    p_department_name STRING,
    p_designation_name STRING,
    p_location_name STRING,
    p_employment_status STRING
)
RETURNS TABLE<
    employee_id STRING,
    employee_name STRING,       -- ✅ NEW
    joining_date DATE,          -- ✅ NEW
    resigned_date DATE,         -- already exists but returned now
    salary_band STRING,         -- ✅ NEW
    reporting_manager STRING,   -- ✅ NEW
    FY STRING,
    CY INT64,
    Quarter STRING,
    Month_Name STRING,
    gender_type STRING,
    Function_Name STRING,
    department_name STRING,
    designation_name STRING,
    location_name STRING,
    employment_status STRING
>
AS (

/**********************************************************
 STEP 1 → Base (Fact + Employee + Salary Band + Dimensions)
**********************************************************/
WITH base AS (
    SELECT
        CAST(fe.employee_id AS STRING) AS employee_id,

        -- EMPLOYEE DIMENSION
        dem.employee_name,
        dem.joining_date,
        dem.reporting_manager,

        -- DATES
        fe.resigned_date,

        -- SALARY BAND DIM
        sb.salary_band,

        -- OTHER DIMENSIONS
        g.gender_type,
        fn.Function_Name,
        d.department_name,
        ds.designation_name,
        l.location_name,
        es.employment_status

    FROM pulse-dev-477810.gold.gl_fact_employee fe

    -- Dim Employee
    LEFT JOIN pulse-dev-477810.gold.gl_dim_emp dem
        ON fe.employee_id = dem.employee_id

    -- Dim Salary Band
    LEFT JOIN pulse-dev-477810.gold.gl_dim_salary_band sb
        ON fe.salary_band_id = sb.salary_band_id

    -- Dim Gender
    LEFT JOIN pulse-dev-477810.gold.gl_dim_gender g
        ON fe.gender_id = g.gender_id

    -- Dim Function
    LEFT JOIN pulse-dev-477810.gold.gl_dim_functions fn
        ON fe.function_id = fn.Function_id

    -- Dim Department
    LEFT JOIN pulse-dev-477810.gold.gl_dim_department d
        ON fe.department_id = d.department_id

    -- Dim Designation
    LEFT JOIN pulse-dev-477810.gold.gl_dim_designation ds
        ON fe.designation_id = ds.designation_id

    -- Dim Location
    LEFT JOIN pulse-dev-477810.gold.gl_dim_location l
        ON fe.location_id = l.location_id

    -- Dim Employment Status
    LEFT JOIN pulse-dev-477810.gold.gl_dim_employment_status es
        ON fe.employment_status_id = es.employment_status_id

    WHERE fe.employment_status_id IN (2,3)
),

/**********************************************************
 STEP 2 → Calculate FY from resigned_date
**********************************************************/
with_fy AS (
    SELECT
        *,
        CONCAT(
            'FY-',
            LPAD(CAST(
                CASE WHEN EXTRACT(MONTH FROM resigned_date) >= 4
                     THEN EXTRACT(YEAR FROM resigned_date)
                     ELSE EXTRACT(YEAR FROM resigned_date) - 1 END
            AS STRING),2,'0'),
            '-',
            LPAD(CAST(
                CASE WHEN EXTRACT(MONTH FROM resigned_date) >= 4
                     THEN EXTRACT(YEAR FROM resigned_date) + 1
                     ELSE EXTRACT(YEAR FROM resigned_date) END
            AS STRING),2,'0')
        ) AS FY_label
    FROM base
),

/**********************************************************
 STEP 3 → Filter CURRENT FY
**********************************************************/
cy_filtered AS (
    SELECT *
    FROM with_fy
    WHERE (
        CASE 
            WHEN EXTRACT(MONTH FROM resigned_date) >= 4 THEN EXTRACT(YEAR FROM resigned_date)
            ELSE EXTRACT(YEAR FROM resigned_date) - 1
        END
    ) = (
        CASE 
            WHEN EXTRACT(MONTH FROM CURRENT_DATE()) >= 4 THEN EXTRACT(YEAR FROM CURRENT_DATE())
            ELSE EXTRACT(YEAR FROM CURRENT_DATE()) - 1
        END
    )
),

/**********************************************************
 STEP 4 → Apply slicer filters
**********************************************************/
filtered AS (
    SELECT *
    FROM cy_filtered
    WHERE (p_month IS NULL OR p_month = 'All' OR FORMAT_DATE('%B', resigned_date) = p_month)
      AND (p_gender_type IS NULL OR p_gender_type = 'All' OR gender_type = p_gender_type)
      AND (p_function_name IS NULL OR p_function_name = 'All' OR Function_Name = p_function_name)
      AND (p_department_name IS NULL OR p_department_name = 'All' OR department_name = p_department_name)
      AND (p_designation_name IS NULL OR p_designation_name = 'All' OR designation_name = p_designation_name)
      AND (p_location_name IS NULL OR p_location_name = 'All' OR location_name = p_location_name)
      AND (p_employment_status IS NULL OR p_employment_status = 'All' OR employment_status = p_employment_status)
),

/**********************************************************
 STEP 5 → Final Output
**********************************************************/
final_output AS (
    SELECT DISTINCT
        employee_id,
        employee_name,
        joining_date,
        resigned_date,
        salary_band,
        reporting_manager,

        FY_label AS FY,
        1 AS CY,

        CASE
            WHEN EXTRACT(MONTH FROM resigned_date) BETWEEN 4 AND 6 THEN 'Q1'
            WHEN EXTRACT(MONTH FROM resigned_date) BETWEEN 7 AND 9 THEN 'Q2'
            WHEN EXTRACT(MONTH FROM resigned_date) BETWEEN 10 AND 12 THEN 'Q3'
            ELSE 'Q4'
        END AS Quarter,

        FORMAT_DATE('%B', resigned_date) AS Month_Name,

        gender_type,
        Function_Name,
        department_name,
        designation_name,
        location_name,
        employment_status

    FROM filtered
)

SELECT *
FROM final_output
ORDER BY FY, Quarter, Month_Name, employee_name

);
