          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">int threadId = ctx.getThreadNum()      // Unique per user
int iteration = vars.getIteration()    // Unique per thread loop

int counter = (threadId * iteration)   // Global-ish counter

int amt = counter + 1
int imei = (counter / 10) + 1
int brid = (counter / 100) + 1
int bid = (counter / 1000) + 1

vars.put(&quot;amt&quot;, amt.toString())
vars.put(&quot;imei&quot;, imei.toString())
vars.put(&quot;brid&quot;, brid.toString())
vars.put(&quot;bid&quot;, bid.toString())
</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PreProcessor>
