    }&#xd;
  ],&#xd;
  &quot;role&quot;: &quot;DMS Admin&quot;,&#xd;
  &quot;userName&quot;: &quot;tester@gmail.com&quot;&#xd;
}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
