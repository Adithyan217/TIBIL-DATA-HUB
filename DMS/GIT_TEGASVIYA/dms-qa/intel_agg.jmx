        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="pre" enabled="false">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import java.text.SimpleDateFormat;
import java.util.ArrayList;
import java.util.Calendar;

// Generate 365 dates starting from January 1, 2023, if not already generated
if (vars.getObject(&quot;datesList&quot;) == null) {
    SimpleDateFormat sdf = new SimpleDateFormat(&quot;yyyy-MM-dd&apos;T&apos;HH:mm:ss&quot;);
    
    // Set the start date to January 1, 2023
    Calendar calendar = Calendar.getInstance();
    calendar.set(2023, Calendar.JANUARY, 1, 0, 0, 0);  // Set the date to January 1, 2023, 00:00:00

    // Generate 365 dates for 365 consecutive days
    ArrayList&lt;String&gt; dates = new ArrayList&lt;&gt;();
    for (int i = 0; i &lt; 365; i++) {
        dates.add(sdf.format(calendar.getTime()));  // Format the date and add it to the list
        calendar.add(Calendar.DAY_OF_YEAR, 1);  // Move to the next day
    }

    // Store the dates list in JMeter&apos;s variable space
    vars.putObject(&quot;datesList&quot;, dates);
}

// Get the current iteration from the Counter
int iteration = Integer.parseInt(vars.get(&quot;iteration&quot;));

// Determine which day and bid should be used
int dayIndex = (iteration - 1) / 100;  // 100 requests per day (10 bids * 10 requests per bid)
int bid = ((iteration - 1) % 100) / 10 + 1; // Cycle through bid values from 1 to 10 for each set of 10 requests

// Get the list of dates
ArrayList&lt;String&gt; datesList = vars.getObject(&quot;datesList&quot;);

// Ensure that `dayIndex` is within bounds to avoid errors
if (dayIndex &gt;= datesList.size()) {
    dayIndex = datesList.size() - 1;  // Prevent going out of bounds
}

// Get the current timestamp for the day
String currentTimestamp = datesList.get(dayIndex);

// Set the `bid` and `timestamp` variables for the current request
vars.put(&quot;bid&quot;, String.valueOf(bid));
vars.put(&quot;timestamp&quot;, currentTimestamp);

// Log the values for debugging purposes
log.info(&quot;Iteration: &quot; + iteration + &quot;, BID: &quot; + bid + &quot;, Timestamp: &quot; + currentTimestamp);
</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223PreProcessor>
