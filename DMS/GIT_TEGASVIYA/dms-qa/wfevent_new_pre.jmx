        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="JDBC Request" enabled="true">
          <stringProp name="dataSource">myDb</stringProp>
          <stringProp name="queryType">Select Statement</stringProp>
          <stringProp name="query">INSERT INTO workflow.wfevtslog(eid, eby, einfo, ecode, estatus)VALUES (${iter_num}, ${iter_num},&apos;{&quot;event&quot;:&quot;ALLOCATE_TO_MERCHANT&quot;,&quot;event_by&quot;:&quot;d@123&quot;,&quot;edetails&quot;:[{&quot;row_id&quot;:${iter_num},&quot;merchant_id&quot;:${iter_num},&quot;device_id&quot;:${iter_num}}]}&apos;, &apos;ALLOCATE_TO_MERCHANT&apos;, &apos;READ&apos;)RETURNING *;</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="JDBC Request" enabled="true">
          <stringProp name="dataSource">myDb</stringProp>
          <stringProp name="queryType">Select Statement</stringProp>
          <stringProp name="query">INSERT INTO workflow.wfalog(lid, aid, eid, astatus, wfstart, wfend)VALUES (${iter_num}, 12, ${iter_num}, &apos;PROCESSED&apos;, &apos;2024-12-06 11:11:06&apos;, &apos;2024-12-06 11:11:07&apos;);</stringProp>
          <stringProp name="queryArguments"></stringProp>
