        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="JDBC Request" enabled="true">
          <stringProp name="dataSource">myDb</stringProp>
          <stringProp name="queryType">Select Statement</stringProp>
          <stringProp name="query">select mpid from registry.merchants where mpid NOT IN (select mid from registry.sb where mid is not null)</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable">resultSet2</stringProp>
          <stringProp name="queryTimeout"></stringProp>
